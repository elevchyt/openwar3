{
  "name": "openwar3",
  "version": "0.4.15",
  "private": true,
  "description": "Browser-first, asset-compatible re-creation of the Warcraft III engine (TypeScript). Ships zero Blizzard assets.",
  "type": "module",
  "packageManager": "pnpm@10.33.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "vite",
    "dev:log": "node tools/dev-log.mjs",
    "build": "node tools/import-cycle-test.mjs && tsc --noEmit && vite build",
    "cycles": "node tools/import-cycle-test.mjs",
    "test": "node tools/test.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json",
    "data:extract": "tsc -p tools/tsconfig.casc.json && node --max-old-space-size=8192 tools/extract-data.mjs",
    "casc:test": "tsc -p tools/tsconfig.casc.json && node --max-old-space-size=8192 tools/casc-test.cjs",
    "data:build": "node tools/build-data-browser.mjs",
    "data:browse": "node tools/build-data-browser.mjs --open",
    "data:verify": "node tools/verify-gameplay-constants.mjs",
    "patches:check": "tsc -p tools/tsconfig.sim.json && node tools/patch-check.cjs",
    "versions:test": "node --max-old-space-size=8192 tools/version-normalize-test.cjs",
    "fallback:draw": "node tools/fallback-draw.mjs && node tools/fallback-svg.mjs && node tools/patch-art.mjs",
    "patches:art": "node tools/patch-art.mjs",
    "map:compat": "node tools/map-compat.cjs",
    "map:compat:test": "node tools/map-compat.cjs --check",
    "campaign:test": "tsc -p tools/tsconfig.casc.json && tsc -p tools/tsconfig.campaign.json && node --max-old-space-size=8192 tools/campaign-index-test.cjs",
    "jass:coverage": "tsc -p tools/tsconfig.jass.json && node tools/native-coverage.mjs",
    "jass:test": "node tools/run-tests.mjs jass",
    "sim:test": "node tools/run-tests.mjs sim",
    "data:audit": "node tools/audit-abilities.mjs",
    "perf:report": "node tools/perf-report.mjs",
    "app": "electron electron/main.mjs",
    "app:dev": "OPENWAR3_DEV=1 electron electron/main.mjs",
    "app:test": "node tools/run-tests.mjs app",
    "icon": "node tools/make-icon.mjs",
    "dist": "pnpm build && node tools/make-icon.mjs && electron-builder",
    "dist:linux": "pnpm build && node tools/make-icon.mjs && electron-builder --linux",
    "dist:linux32": "pnpm build && node tools/make-icon.mjs && node tools/build-legacy-main.mjs && electron-builder --linux --ia32 -c.electronVersion=18.3.15 -c.extraMetadata.main=electron/main-legacy.cjs",
    "dist:win": "pnpm build && node tools/make-icon.mjs && electron-builder --win -c.electronVersion=43.7.0",
    "dist:mac": "pnpm build && node tools/make-icon.mjs && electron-builder --mac",
    "release": "pnpm build && node tools/make-icon.mjs && electron-builder --publish always && node tools/replay-bundle.mjs --publish",
    "replay:bundle": "node tools/replay-bundle.mjs",
    "release:linux32": "pnpm build && node tools/make-icon.mjs && node tools/build-legacy-main.mjs && electron-builder --linux --ia32 -c.electronVersion=18.3.15 -c.extraMetadata.main=electron/main-legacy.cjs --publish always",
    "hive:post": "node tools/hive-post.mjs",
    "release:win": "pnpm build && node tools/make-icon.mjs && electron-builder --win -c.electronVersion=43.7.0 --publish always",
    "relay": "node server/relay.mjs",
    "relay-kill": "node server/relay-kill.mjs",
    "relay:test": "node tools/run-tests.mjs relay",
    "loopback:test": "node tools/loopback-test.mjs",
    "test:free": "node tools/run-tests.mjs relay sim jass --free",
    "web:typecheck": "pnpm --dir web typecheck"
  },
  "dependencies": {
    "electron-updater": "^6.6.2",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@huggingface/transformers": "4.3.1",
    "@openwar3/ui": "link:packages/ui",
    "@types/node": "^24.13.3",
    "aws4fetch": "^1.0.20",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "events": "^3.3.0",
    "fengari": "0.1.5",
    "gl-matrix": "^3.4.3",
    "husky": "^9.1.7",
    "lucide": "^1.75.0",
    "mdx-m3-viewer": "^5.12.0",
    "onnxruntime-web": "1.31.0-dev.20260914-8d85527a0",
    "pako": "^3.0.1",
    "railway": "3.11.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "electron"
    ],
    "patchedDependencies": {
      "mdx-m3-viewer@5.12.0": "patches/mdx-m3-viewer@5.12.0.patch",
      "fengari@0.1.5": "patches/fengari@0.1.5.patch"
    }
  },
  "main": "electron/main.mjs",
  "author": "elevchyt",
  "build": {
    "appId": "dev.elevchyt.openwar3",
    "productName": "OpenWar3",
    "copyright": "OpenWar3 contributors",
    "icon": "build/icon.png",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "icon": "build/icons",
      "synopsis": "Browser-first re-creation of the Warcraft III engine",
      "syncDesktopName": true,
      "executableName": "openwar3",
      "desktop": {
        "entry": {
          "Name": "OpenWar3"
        }
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "include": "packaging/windows-installer.nsh",
      "artifactName": "OpenWar3-Setup-${version}.${ext}",
      "shortcutName": "OpenWar3",
      "uninstallDisplayName": "OpenWar3"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.games",
      "icon": "build/icon.icns"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "elevchyt",
        "repo": "openwar3"
      }
    ]
  },
  "desktopName": "openwar3.desktop"
}
