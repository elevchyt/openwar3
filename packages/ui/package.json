{
  "name": "@openwar3/ui",
  "version": "0.1.0",
  "private": true,
  "description": "OpenWar3's glue-screen UI kit: the Frozen Throne's buttons, panels, tooltips and loading bar, redrawn with zero Blizzard assets. Shared by the game and the landing page.",
  "type": "module",
  "exports": {
    "./ui.css": "./src/ui.css",
    "./fonts.css": "./src/fonts.css",
    "./dom": "./src/dom/index.ts",
    "./react": "./src/react/index.ts",
    "./frames/*": "./src/frames/*",
    "./fonts/*": "./src/fonts/*"
  },
  "scripts": {
    "frames": "node scripts/frames.mjs"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
