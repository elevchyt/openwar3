// OpenWar3 override — strings the game has no key for.
//
// Layered onto `UI\FrameDef\GlobalStrings.fdf` (src/overrides/index.ts), which is where every
// other label on these two screens comes from. Blizzard never shipped a second melee AI, so
// there is no COMPUTERPLUS_* to reuse and no localisation to inherit: these keys are ours, and
// they follow the file's own naming so they read as part of the same table.
//
// The three "Computer+ (…)" labels a SLOT MENU shows are deliberately NOT here — they are in
// src/ui/playerSlots.ts beside the classic ones they mirror, because the owner line of a hover
// tooltip asks for them mid-match, with no FDF library in scope.

StringList {
    // Custom Game → Advanced Options. Sits in the same column as COLON_LOCK_TEAMS
    // ("Lock Teams:") and COLON_ADV_SHARED_CONTROL ("Full Shared Unit Control:"), and is no
    // longer than the latter.
    COLON_COMPUTER_PLUS         "Computer+ (Improved AI):",

    // Options → Gameplay, directly under AUTOSAVE_REPLAY ("Automatically Save Replays").
    COMPUTER_PLUS_DEFAULT       "Use Computer+ as default AI",
}
