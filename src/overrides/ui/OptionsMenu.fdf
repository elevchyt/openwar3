// OpenWar3 override — `UI\FrameDef\Glue\OptionsMenu.fdf`, Gameplay panel.
//
// Issue #124 asks for three changes to this panel, and all three are about options that mean
// nothing to this engine being replaced by one that does:
//
//   · "Game Port:" + its edit box GO. There is no port to set — a LAN game here is a WebRTC
//     relay (docs/multiplayer.md), not a socket on 6112.
//   · "Chat Support:" + its dropdown GO. It chose a Battle.net chat gateway that no longer
//     exists on any side.
//   · a new checkbox arrives under "Automatically Save Replays": the default value of the
//     Custom Game screen's Computer+ switch, remembered in localStorage like every other
//     option (src/data/options.ts).
//
// The removals are listed in the manifest (src/overrides/index.ts) rather than written here,
// because FDF has no syntax for deleting a frame — it is a declaration language. Nothing else
// anchors to the four frames that go, so the panel simply ends one row earlier.
//
// Issue #141 adds one more row, and it goes in the MIDDLE of the panel rather than at the end:
// a "Healthbars:" pulldown directly under "Always show Health Bars", because it says what
// those bars look like. Built as the Video panel's "Resolution:" row is built — a
// `StandardInfoTextTemplate` label with an `OptionsPopupMenuBackdropTemplate` hung off its
// right edge — so the two screens' pulldowns are the same control.
//
// Issue #142 then RESHAPES the panel, and this file's frames move with it. Four of the game's
// own checkbox rows are retired (the manifest says which and src/data/options.ts says why), a
// second pulldown — "Hotkeys:" — closes the panel under the health-bar pair, and the two rows
// that are about the MATCH rather than about the screen ("Automatically Save Replays" and the
// Computer+ default hanging off it) move to the TOP of what is left. So the panel now reads:
//
//     Mouse Scroll / Keyboard Scroll sliders     (the game's, untouched)
//     [x] Automatically Save Replays             (the game's, re-anchored by the manifest)
//     [x] Use Computer+ as default AI            (ours, still hanging off it)
//     [x] Always show Health Bars                (the game's, re-anchored by the manifest)
//     Healthbars:  [ Default ]                   (ours)
//     Hotkeys:     [ Legacy  ]                   (ours)
//     [x] Show hotkeys on action buttons         (ours)
//
// The two re-anchorings are the manifest's `repoint`, because an FDF panel is a chain of rows
// and those two rows are the game's own frames: only their SetPoints change, so their labels
// come along without being restated here.

Frame "TEXT" "HealthBarStyleLabel" INHERITS "StandardInfoTextTemplate" {
    // -0.02 under the checkbox above: the gap the file's own "GamePortLabel" used where a
    // label row followed a checkbox row, rather than the -0.005 that separates two checkboxes.
    SetPoint TOPLEFT, "HealthBarsCheckBox", BOTTOMLEFT, 0.0, -0.02,
    Text "COLON_HEALTHBARS",
}

Frame "BACKDROP" "HealthBarStyleBackdrop" INHERITS "OptionsPopupMenuBackdropTemplate" {
    SetPoint LEFT, "HealthBarStyleLabel", RIGHT, 0.01, 0.0,

    Frame "POPUPMENU" "HealthBarStyleMenu" INHERITS WITHCHILDREN "OptionsPopupMenuTemplate" {
        SetPoint TOPLEFT, "HealthBarStyleBackdrop", TOPLEFT, 0.012, -0.013,

        PopupMenuFrame "HealthBarStylePopupMenuMenu",
        Frame "MENU" "HealthBarStylePopupMenuMenu" INHERITS WITHCHILDREN "StandardPopupMenuMenuTemplate" {
        }
    }
}

// "Hotkeys:" (issue #142) — the second pulldown row, and the last row of the panel. Spaced off
// the row above it by the Video panel's own numbers for two consecutive pulldowns, which is the
// one place in this file a pulldown ever follows a pulldown (AnimQualityLabel/Backdrop under
// ModelDetail's, and the three rows under those): the LABELS are **-0.02625** apart and the
// BACKDROPS hang off each other at **+0.01375** rather than off their labels, so the boxes line
// up however tall the type is. The two numbers are one measurement — a backdrop is 0.053 tall
// against a 0.013 label, so 0.053 − 0.01375 is the 0.0393 that 0.013 + 0.02625 also comes to,
// and using the other pair's -0.002 (which pays for a retired row between them) walks the box
// 21 px down off its own label by the second row.
Frame "TEXT" "HotkeysLabel" INHERITS "StandardInfoTextTemplate" {
    SetPoint TOPLEFT, "HealthBarStyleLabel", BOTTOMLEFT, 0.0, -0.02625,
    Text "COLON_HOTKEYS",
}

Frame "BACKDROP" "HotkeysBackdrop" INHERITS "OptionsPopupMenuBackdropTemplate" {
    SetPoint TOPLEFT, "HealthBarStyleBackdrop", BOTTOMLEFT, 0.0, 0.01375,

    Frame "POPUPMENU" "HotkeysMenu" INHERITS WITHCHILDREN "OptionsPopupMenuTemplate" {
        SetPoint TOPLEFT, "HotkeysBackdrop", TOPLEFT, 0.012, -0.013,

        PopupMenuFrame "HotkeysPopupMenuMenu",
        Frame "MENU" "HotkeysPopupMenuMenu" INHERITS WITHCHILDREN "StandardPopupMenuMenuTemplate" {
        }
    }
}

// "Show hotkeys on action buttons" — a checkbox row under the "Hotkeys:" pulldown, and the last
// row of the panel. It hangs off the LABEL rather than the backdrop, because the backdrop starts
// right of the label and the checkbox column is the label's. The gap is the pulldown pair's own
// label-to-label step (-0.02625) less the half a checkbox is taller than a label, so the box sits
// where a third pulldown's label would have been centred.
Frame "GLUECHECKBOX" "ShowHotkeysCheckBox" INHERITS WITHCHILDREN "StandardCheckBoxTemplate" {
    SetPoint TOPLEFT, "HotkeysLabel", BOTTOMLEFT, 0.0, -0.02075,
}

Frame "TEXT" "ShowHotkeysLabel" INHERITS "StandardInfoTextTemplate" {
    SetPoint LEFT, "ShowHotkeysCheckBox", RIGHT, 0.01, 0.0,
    Text "SHOW_HOTKEYS_ON_BUTTONS",
}

Frame "GLUECHECKBOX" "ComputerPlusDefaultCheckBox" INHERITS WITHCHILDREN "StandardCheckBoxTemplate" {
    SetPoint TOPLEFT, "AutosaveReplayCheckBox", BOTTOMLEFT, 0.0, -0.005,
}

Frame "TEXT" "ComputerPlusDefaultLabel" INHERITS "StandardInfoTextTemplate" {
    SetPoint LEFT, "ComputerPlusDefaultCheckBox", RIGHT, 0.01, 0.0,
    Text "COMPUTER_PLUS_DEFAULT",
}
