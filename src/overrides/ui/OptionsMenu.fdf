// OpenWar3 override — `UI\FrameDef\Glue\OptionsMenu.fdf`, Gameplay panel.
//
// Issue #124 asks for three changes to this panel, and all three are about options that mean
// nothing to this engine being replaced by one that does:
//
//   · "Game Port:" + its edit box GO. There is no port to set — a LAN game here is a WebRTC
//     relay (docs/multiplayer.md), not a socket on 6112.
//   · "Chat Support:" + its dropdown GO. It chose a Battle.net chat gateway that no longer
//     exists on any side.
//   · a new checkbox arrives under "Automatically Save Replays": the default value of the
//     Custom Game screen's Computer+ switch, remembered in localStorage like every other
//     option (src/data/options.ts).
//
// The removals are listed in the manifest (src/overrides/index.ts) rather than written here,
// because FDF has no syntax for deleting a frame — it is a declaration language. Nothing else
// anchors to the four frames that go, so the panel simply ends one row earlier.
//
// Issue #141 adds one more row, and it goes in the MIDDLE of the panel rather than at the end:
// a "Healthbars:" pulldown directly under "Always show Health Bars", because it says what
// those bars look like. Built as the Video panel's "Resolution:" row is built — a
// `StandardInfoTextTemplate` label with an `OptionsPopupMenuBackdropTemplate` hung off its
// right edge — so the two screens' pulldowns are the same control.
//
// Issue #142 then RESHAPES the panel, and this file's frames move with it. Four of the game's
// own checkbox rows are retired (the manifest says which and src/data/options.ts says why), a
// second pulldown — "Hotkeys:" — closes the panel under the health-bar pair, and the two rows
// that are about the MATCH rather than about the screen ("Automatically Save Replays" and the
// Computer+ default hanging off it) move to the TOP of what is left. So the panel now reads:
//
//     Mouse Scroll / Keyboard Scroll sliders     (the game's, untouched)
//     [x] Automatically Save Replays             (the game's, re-anchored by the manifest)
//     [x] Use Computer+ as default AI            (ours, still hanging off it)
//     [x] Always show Health Bars                (the game's, re-anchored by the manifest)
//     Healthbars:  [ Default ]                   (ours)
//     Hotkeys:     [ Legacy  ]                   (ours)
//     [x] Show hotkeys on command buttons        (ours)
//
// The two re-anchorings are the manifest's `repoint`, because an FDF panel is a chain of rows
// and those two rows are the game's own frames: only their SetPoints change, so their labels
// come along without being restated here.

Frame "TEXT" "HealthBarStyleLabel" INHERITS "StandardInfoTextTemplate" {
    // -0.02 under the checkbox above: the gap the file's own "GamePortLabel" used where a
    // label row followed a checkbox row, rather than the -0.005 that separates two checkboxes.
    SetPoint TOPLEFT, "HealthBarsCheckBox", BOTTOMLEFT, 0.0, -0.02,
    Text "COLON_HEALTHBARS",
}

Frame "BACKDROP" "HealthBarStyleBackdrop" INHERITS "OptionsPopupMenuBackdropTemplate" {
    SetPoint LEFT, "HealthBarStyleLabel", RIGHT, 0.01, 0.0,

    Frame "POPUPMENU" "HealthBarStyleMenu" INHERITS WITHCHILDREN "OptionsPopupMenuTemplate" {
        SetPoint TOPLEFT, "HealthBarStyleBackdrop", TOPLEFT, 0.012, -0.013,

        PopupMenuFrame "HealthBarStylePopupMenuMenu",
        Frame "MENU" "HealthBarStylePopupMenuMenu" INHERITS WITHCHILDREN "StandardPopupMenuMenuTemplate" {
        }
    }
}

// "Hotkeys:" (issue #142) — the second pulldown row, and the last row of the panel. Spaced off
// the row above it by the Video panel's own numbers for two consecutive pulldowns, which is the
// one place in this file a pulldown ever follows a pulldown (AnimQualityLabel/Backdrop under
// ModelDetail's, and the three rows under those): the LABELS are **-0.02625** apart and the
// BACKDROPS hang off each other at **+0.01375** rather than off their labels, so the boxes line
// up however tall the type is. The two numbers are one measurement — a backdrop is 0.053 tall
// against a 0.013 label, so 0.053 − 0.01375 is the 0.0393 that 0.013 + 0.02625 also comes to,
// and using the other pair's -0.002 (which pays for a retired row between them) walks the box
// 21 px down off its own label by the second row.
Frame "TEXT" "HotkeysLabel" INHERITS "StandardInfoTextTemplate" {
    SetPoint TOPLEFT, "HealthBarStyleLabel", BOTTOMLEFT, 0.0, -0.02625,
    Text "COLON_HOTKEYS",
}

Frame "BACKDROP" "HotkeysBackdrop" INHERITS "OptionsPopupMenuBackdropTemplate" {
    SetPoint TOPLEFT, "HealthBarStyleBackdrop", BOTTOMLEFT, 0.0, 0.01375,

    Frame "POPUPMENU" "HotkeysMenu" INHERITS WITHCHILDREN "OptionsPopupMenuTemplate" {
        SetPoint TOPLEFT, "HotkeysBackdrop", TOPLEFT, 0.012, -0.013,

        PopupMenuFrame "HotkeysPopupMenuMenu",
        Frame "MENU" "HotkeysPopupMenuMenu" INHERITS WITHCHILDREN "StandardPopupMenuMenuTemplate" {
        }
    }
}

// The hotkey EDITOR's door (issue #156) — an icon button to the right of the "Hotkeys:" pulldown,
// shown only while the pulldown says Custom, because Custom is the one rung with a file to edit
// (src/ui/fdfOptions.ts toggles it).
//
// It is built exactly as the Single Player menu builds the lens button beside the profile name
// (SinglePlayerMenu.fdf `ProfileButtonBackdrop`): the glue's TINY socket
// (`StandardMenuTinyButtonBaseBackdrop`, 0.11 x 0.055) holding a 0.03 x 0.026
// `StandardIconicButtonTemplate` 0.009 in from its right and 0.014 down, whose faces are Battle.net's
// PROFILE button (BattleNetChatPanel.fdf `ProfileButton`): `bnet-mainmenu-profile-*` in the
// `GlueScreen-Button2` border, up, down and disabled. The socket's texture is transparent for its
// left ~40%, so its frame starts well left of the ornament it shows — hence the negative offset.
Frame "BACKDROP" "HotkeyEditorBackdrop" INHERITS "StandardMenuTinyButtonBaseBackdrop" {
    SetPoint LEFT, "HotkeysBackdrop", RIGHT, -0.062, 0.0,

    Frame "GLUEBUTTON" "HotkeyEditorButton" INHERITS WITHCHILDREN "StandardIconicButtonTemplate" {
        Width 0.03,
        Height 0.026,
        SetPoint TOPRIGHT, "HotkeyEditorBackdrop", TOPRIGHT, -0.009, -0.014,

        ControlBackdrop "HotkeyEditorButtonBackdrop",
        Frame "BACKDROP" "HotkeyEditorButtonBackdrop" {
            BackdropBackground  "UI\Widgets\BattleNet\bnet-mainmenu-profile-up.blp",
            BackdropCornerFlags "UL|UR|BL|BR|T|L|B|R",
            BackdropCornerSize  0.013,
            BackdropBackgroundSize  0.026,
            BackdropBackgroundInsets 0.004 0.004 0.004 0.004,
            BackdropEdgeFile  "UI\Widgets\Glues\GlueScreen-Button2-BackdropBorder.blp",
        }

        ControlPushedBackdrop "HotkeyEditorButtonPushedBackdrop",
        Frame "BACKDROP" "HotkeyEditorButtonPushedBackdrop" {
            BackdropBackground  "UI\Widgets\BattleNet\bnet-mainmenu-profile-down.blp",
            BackdropCornerFlags "UL|UR|BL|BR|T|L|B|R",
            BackdropCornerSize  0.013,
            BackdropBackgroundSize  0.026,
            BackdropBackgroundInsets 0.004 0.004 0.004 0.004,
            BackdropEdgeFile  "UI\Widgets\Glues\GlueScreen-Button2-BackdropBorder-Down.blp",
        }

        ControlDisabledBackdrop "HotkeyEditorButtonDisabledBackdrop",
        Frame "BACKDROP" "HotkeyEditorButtonDisabledBackdrop" {
            BackdropBackground  "UI\Widgets\BattleNet\bnet-mainmenu-profile-disabled.blp",
            BackdropCornerFlags "UL|UR|BL|BR|T|L|B|R",
            BackdropCornerSize  0.013,
            BackdropBackgroundSize  0.026,
            BackdropBackgroundInsets 0.004 0.004 0.004 0.004,
            BackdropEdgeFile  "UI\Widgets\Glues\GlueScreen-Button2-BackdropBorder-Disabled.blp",
        }
    }
}

// "Show hotkeys on command buttons" — a checkbox row under the "Hotkeys:" pulldown, and the last
// row of the panel. It hangs off the LABEL rather than the backdrop, because the backdrop starts
// right of the label and the checkbox column is the label's. The gap is the pulldown pair's own
// label-to-label step (-0.02625) less the half a checkbox is taller than a label, so the box sits
// where a third pulldown's label would have been centred.
Frame "GLUECHECKBOX" "ShowHotkeysCheckBox" INHERITS WITHCHILDREN "StandardCheckBoxTemplate" {
    SetPoint TOPLEFT, "HotkeysLabel", BOTTOMLEFT, 0.0, -0.02075,
}

Frame "TEXT" "ShowHotkeysLabel" INHERITS "StandardInfoTextTemplate" {
    SetPoint LEFT, "ShowHotkeysCheckBox", RIGHT, 0.01, 0.0,
    Text "SHOW_HOTKEYS_ON_BUTTONS",
}

Frame "GLUECHECKBOX" "ComputerPlusDefaultCheckBox" INHERITS WITHCHILDREN "StandardCheckBoxTemplate" {
    SetPoint TOPLEFT, "AutosaveReplayCheckBox", BOTTOMLEFT, 0.0, -0.005,
}

Frame "TEXT" "ComputerPlusDefaultLabel" INHERITS "StandardInfoTextTemplate" {
    SetPoint LEFT, "ComputerPlusDefaultCheckBox", RIGHT, 0.01, 0.0,
    Text "COMPUTER_PLUS_DEFAULT",
}

// ---------------------------------------------------------------------------------------------
// Video panel: "Low Performance Mode" (issue #161), a checkbox row directly under "Resolution:"
// and above "Model Detail:" — one switch that puts every rung on this panel that costs something
// at its cheapest, for a machine that cannot afford them (src/render/videoQuality.ts holds the
// list, and Resolution and Gamma are deliberately not on it).
//
// THE GAME AUTHORED THIS SLOT. The shipped 1.30.4 file has a checkbox row commented out in
// exactly this position — `FixedAspectRatioCheckboxLabel` / `FixedAspectRatioCheckBox`, marked
// "Disabled for 1.29, needs some work" — and it left behind both that row's anchors AND the two
// re-anchorings `ModelDetailLabel` / `ModelDetailBackdrop` wear when a row stands between them
// and Resolution. So the shape of the row is the file's; what is ours is the ARRANGEMENT, which
// is box-then-label (the game's dead row put its label in the label column and its box in the
// pulldown column). The panel's other four checkbox rows — the game's own "Automatically Save
// Replays" and our three — all read box-then-label, and a mode's answer is a tick rather than a
// value, so it takes no colon and wants no pulldown column.
//
// The two offsets are one measurement, and the second was MEASURED IN THE RUNNING SCREEN rather
// than taken from the file. The pulldown rows are 0.055 apart (a 0.053 backdrop and the 0.002
// between two of them) and a label is 0.013 tall, so there is already 0.042 of EMPTY label column
// between "Resolution:" and "Model Detail:" — the space the pulldowns' own chrome fills on the
// right — and a 0.024 box very nearly fits in it as it stands. The game's dead row paid **0.0105**
// for the same insertion (it stepped -0.02625 twice where "Model Detail:" alone steps -0.042), and
// at that price the panel overran: this panel carries a row the 2003 one never did ("Vertical
// Sync"), and the full 0.0105 pushed that last row onto the frame's bottom rail. So the row takes
// **0.005** — every row below shifts by that much in the manifest (src/overrides/index.ts), which
// carries the whole rest of the panel, since every row under Model Detail hangs off Model Detail —
// and the box is CENTRED in the band that leaves: (0.042 + 0.005 - 0.024) / 2 = **0.0115** of gap
// above it and the same below.
//
// "Vertical Sync" then tucks under "Occlusion:" by that same 0.0115 rather than the 0.02075 it
// used to, so the panel's two checkbox rows are spaced alike and the last row lands where it
// always did. That step is the Gameplay panel's, where the panel is a row emptier.
Frame "GLUECHECKBOX" "LowPerfCheckBox" INHERITS WITHCHILDREN "StandardCheckBoxTemplate" {
    SetPoint TOPLEFT, "ResolutionLabel", BOTTOMLEFT, 0.0, -0.0115,
}

Frame "TEXT" "LowPerfLabel" INHERITS "StandardInfoTextTemplate" {
    SetPoint LEFT, "LowPerfCheckBox", RIGHT, 0.01, 0.0,
    Text "LOW_PERFORMANCE_MODE",
}

// ---------------------------------------------------------------------------------------------
// Video panel: "Vertical Sync", a checkbox row under the game's last row, "Occlusion:". 1.30.4's
// panel has no frame-rate or vsync control, so the row is ours; in the desktop app it is a
// Chromium LAUNCH switch, applied by the relaunch OK offers (electron/main.mjs,
// src/ui/fdfOptions.ts). Spaced by the same 0.0115 as the "Low Performance Mode" row above — see
// there for why this panel's checkbox rows tuck closer under their labels than the Gameplay
// panel's -0.02075 does.
Frame "GLUECHECKBOX" "VsyncCheckBox" INHERITS WITHCHILDREN "StandardCheckBoxTemplate" {
    SetPoint TOPLEFT, "OcclusionLabel", BOTTOMLEFT, 0.0, -0.0115,
}

Frame "TEXT" "VsyncLabel" INHERITS "StandardInfoTextTemplate" {
    SetPoint LEFT, "VsyncCheckBox", RIGHT, 0.01, 0.0,
    Text "VSYNC",
}

// ---------------------------------------------------------------------------------------------
// Gameplay panel: "Detect Gamepad" (issue #162), a button under "Show hotkeys on command
// buttons" — the panel's last row. Nothing in 1.30.4 knows a controller exists, so the row is
// ours. Pressing it LISTENS for ten seconds and pairs whichever pad presses a button in that
// window; the button greys and counts the seconds down on itself while it does. Once a pad IS
// paired the same button reads "Unpair Gamepad" (`UNPAIR_GAMEPAD`) and hands the game back to the
// mouse and keyboard — one frame, two faces, dressed by src/ui/gamepad.ts. The game's own button art, as the dialogs' OK and Cancel wear it
// (`StandardButtonTemplate`), narrowed to fit under the checkbox column and hung off the
// checkbox's left edge a checkbox-row step down.
Frame "GLUETEXTBUTTON" "GamepadButton" INHERITS WITHCHILDREN "StandardButtonTemplate" {
    Width 0.16,
    SetPoint TOPLEFT, "ShowHotkeysCheckBox", BOTTOMLEFT, 0.0, -0.008,

    ButtonText "GamepadButtonText",
    Frame "TEXT" "GamepadButtonText" INHERITS "StandardButtonTextTemplate" {
        Text "DETECT_GAMEPAD",
    }
}
