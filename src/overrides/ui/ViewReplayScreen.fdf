// OpenWar3 override — `UI\FrameDef\Glue\ViewReplayScreen.fdf`.
//
// Two things the 2003 screen has no frame for: WHO played the highlighted replay, and the way to
// the replay collection (the second half of this file).
//
// The game's summary stops at "Number of Players:" — its replay list has nothing else to say
// about a file until it is opened. Ours reads each replay's header anyway (ui/fdfViewReplay.ts,
// for the version note on a row), and the header names every seat with its race and team, so the
// screen lists them: the players under their teams as the loading screen groups them ("Team %d",
// no heading when everybody is on one team), each with the race symbol the Allies dialog wears
// beside a name, and the replay's watchers last.
//
// An empty container the code fills, hung straight under the "Number of Players" row — which is
// anchored to the summary pane's own BOTTOMLEFT, so the box travels with the pane's widescreen
// nudge — and exactly as wide as that row. It ends above the panel's bottom border; a replay with
// more players than fit SCROLLS inside it rather than running over the chrome.
//
// The scroll is the game's own: a FRAME handed a SCROLLBAR scrolls its children
// (ui/fdf/widgets.ts `buildScrollFrame`, as the LAN lobby's team rows do), and the bar is the
// glue's `StandardScrollBarTemplate` — the one ListBoxWar3.fdf hangs off the replay list beside
// it, arrows and all — drawn only while the rows overrun the box.
Frame "FRAME" "ReplayPlayersBox" {
    SetPoint TOPLEFT, "NumPlayersLabel", BOTTOMLEFT, 0.0, -0.008,
    Width 0.271875,
    Height 0.135,

    Frame "SCROLLBAR" "ReplayPlayersScrollBar" INHERITS WITHCHILDREN "StandardScrollBarTemplate" {
        SetPoint TOPRIGHT, "ReplayPlayersBox", TOPRIGHT, 0.0, 0.0,
        UseActiveContext,
    }
}

// The REPLAY COLLECTION's door (src/ui/replayBrowser.ts) — an icon button right of the "View
// Replay" title that opens the Download Replays dialog. (It was tried in the list panel's top
// right corner and came back: beside the title is the developer's placement.)
//
// The BUTTON is the Options screen's hotkey-editor button (OptionsMenu.fdf `HotkeyEditorButton`):
// a 0.03 x 0.026 `StandardIconicButtonTemplate` in the `GlueScreen-Button2` border (up, down,
// disabled). That one sits in the glue's tiny socket (`StandardMenuTinyButtonBaseBackdrop`); this
// one does NOT — the developer's call, the socket's ornament was too much furniture beside a
// title — so its holder is a bare frame the button's own size.
// Its face is the plain glue button field with Lucide's `globe` drawn over it by the screen
// (`dressReplayBrowserButton`), the Download Maps entry's own glyph.
Frame "FRAME" "ReplayOnlineBackdrop" {
    Width 0.03,
    Height 0.026,
    SetPoint LEFT, "ViewReplayTitle", RIGHT, 0.008, 0.0,

    Frame "GLUEBUTTON" "ReplayOnlineButton" INHERITS WITHCHILDREN "StandardIconicButtonTemplate" {
        Width 0.03,
        Height 0.026,
        SetPoint TOPRIGHT, "ReplayOnlineBackdrop", TOPRIGHT, 0.0, 0.0,

        ControlBackdrop "ReplayOnlineButtonBackdrop",
        Frame "BACKDROP" "ReplayOnlineButtonBackdrop" {
            BackdropBackground  "UI\Widgets\Glues\GlueScreen-Button1-BackdropBackground.blp",
            BackdropCornerFlags "UL|UR|BL|BR|T|L|B|R",
            BackdropCornerSize  0.013,
            BackdropBackgroundSize  0.026,
            BackdropBackgroundInsets 0.004 0.004 0.004 0.004,
            BackdropEdgeFile  "UI\Widgets\Glues\GlueScreen-Button2-BackdropBorder.blp",
        }

        ControlPushedBackdrop "ReplayOnlineButtonPushedBackdrop",
        Frame "BACKDROP" "ReplayOnlineButtonPushedBackdrop" {
            BackdropBackground  "UI\Widgets\Glues\GlueScreen-Button1-BackdropBackground.blp",
            BackdropCornerFlags "UL|UR|BL|BR|T|L|B|R",
            BackdropCornerSize  0.013,
            BackdropBackgroundSize  0.026,
            BackdropBackgroundInsets 0.004 0.004 0.004 0.004,
            BackdropEdgeFile  "UI\Widgets\Glues\GlueScreen-Button2-BackdropBorder-Down.blp",
        }

        ControlDisabledBackdrop "ReplayOnlineButtonDisabledBackdrop",
        Frame "BACKDROP" "ReplayOnlineButtonDisabledBackdrop" {
            BackdropBackground  "UI\Widgets\Glues\GlueScreen-Button1-BackdropBackground-Disabled.blp",
            BackdropCornerFlags "UL|UR|BL|BR|T|L|B|R",
            BackdropCornerSize  0.013,
            BackdropBackgroundSize  0.026,
            BackdropBackgroundInsets 0.004 0.004 0.004 0.004,
            BackdropEdgeFile  "UI\Widgets\Glues\GlueScreen-Button2-BackdropBorder-Disabled.blp",
        }
    }
}
