  "changes": [
    {
      "note": "Necromancer rework reverted: Unholy Frenzy back in place of Incite Unholy Frenzy, spell order Raise Dead, Unholy Frenzy, Cripple again (3.0.0 carries the 1.30.4 list and buttons; Auuf is left orphaned)",
      "source": "undocumented",
      "files": {
        "Units\\UnitAbilities.slk": {
          "unec": {
            "abilList": "Acri,Arai,Aiun,Auhf"
          }
        },
        "Units\\UndeadAbilityFunc.txt": {
          "Acri": {
            "Buttonpos": "2,2"
          },
          "Arai": {
            "Buttonpos": "0,2",
            "Unbuttonpos": "0,2"
          }
        }
      }
    },
    {
      "note": "Cripple back to 125 mana, -50 % attack rate and -50 % damage (3.0.0's Cost1 of 90 is a later release's)",
      "source": "undocumented",
      "files": {
        "Units\\AbilityData.slk": {
          "Acri": {
            "Cost1": 125,
            "DataB1": 0.5,
            "DataC1": 0.5
          }
        }
      }
    },
    {
      "note": "Cripple needs Necromancer Master Training again",
      "source": "undocumented",
      "files": {
        "Units\\UndeadAbilityFunc.txt": {
          "Acri": {
            "Requires": "Rune",
            "Requiresamount": 2
          }
        }
      }
    },
    {
      "note": "Raise Dead needs no training again",
      "source": "undocumented",
      "files": {
        "Units\\UndeadAbilityFunc.txt": {
          "Arai": {
            "Requires": null,
            "Requiresamount": null
          }
        }
      }
    },
    {
      "note": "Skeletal Mastery needs no Necromancer training again (3.0.0's unpl requirement is a later release's); what it asks for instead is the Necropolis (unpl), as 1.32.8's tables have it — 1.31.1's tables (w3x2lni's zhCN-1.31.1 copy) had Rune alone, 1.30.4 the Halls",
      "source": "undocumented",
      "files": {
        "Units\\UndeadUpgradeFunc.txt": {
          "Rusm": {
            "Requires": "unpl"
          }
        }
      }
    },
    {
      "note": "Necromancer training tooltips name Unholy Frenzy and Cripple again",
      "source": "undocumented",
      "files": {
        "Units\\UndeadUpgradeStrings.txt": {
          "Rune": {
            "Ubertip": {
              "replace": [
                [
                  "cast Raise Dead.",
                  "cast Unholy Frenzy."
                ],
                [
                  "cast Incite Unholy Frenzy.",
                  "cast Cripple."
                ]
              ]
            }
          }
        }
      }
    },
    {
