      "implemented": false
    },
    {
      "key": "impale-uninterruptible-airborne-vulnerable",
      "note": "Impale reads its two new fields: an order no longer cancels it, and units in the air are damageable and attackable (still untargetable by spells)",
      "implemented": false
    },
    {
      "key": "stasis-trap-detonation-delay",
      "note": "Stasis Trap waits its new Detonation Delay field (DataE, 0.5 s) after triggering instead of a fixed 1 s",
      "implemented": false
    },
    {
      "key": "doom-movement-slow",
      "note": "Doom slows its target by its new Movement Speed Factor field (DataE); its creep-level cap became a field too",
      "implemented": false
    },
    {
      "key": "summon-prawns-creep-reaction",
      "note": "A Makrura Deepseer (Summon Prawns) no longer stops reacting to enemies when a single unit attacks it",
      "implemented": false
    }
